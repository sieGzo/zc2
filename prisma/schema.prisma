generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  // DLA NextAuth: email może być null (nie zawsze dostępny), unikalny gdy istnieje
  email            String?   @unique
  // DLA Credentials: login po username — ale NIE wymagaj dla OAuth
  username         String?   @unique
  // DLA Credentials: hasło tylko dla kont lokalnych — NIE wymagaj dla OAuth
  passwordHash     String?
  emailVerified    DateTime?
  emailToken       String?   @unique
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  name   String?
  image  String?   // typowe pole używane przez NextAuth
  age    Int?

  accounts Account[]
  sessions Session[]
  visitedCountries String[] // np. ["PL","DE","ES"]

  // Backref do Route
  routes Route[] @relation("UserRoutes")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  verified  Boolean  @default(false)
}

model Visit {
  id        String   @id @default(cuid())
  ipHash    String   @db.VarChar(64)
  userAgent String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash])
}

// wymagane przez NextAuth (dopasowane do adaptera)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Route {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("UserRoutes", fields: [userId], references: [id])

  name     String
  mode     String
  startLat Float
  startLon Float
  endLat   Float
  endLon   Float

  distance Int
  time     Int
  geojson  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
